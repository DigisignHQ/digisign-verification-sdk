{
  "name": "@digisign/react-native-verification-sdk",
  "version": "0.1.0",
  "description": "DigiSign verification WebView with controlled camera and microphone permissions",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.2.3",
    "react-native": ">=0.86.3",
    "react-native-webview": ">=13.15.0",
    "react-native-permissions": ">=5.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react-native-permissions": "^5.6.2",
    "typescript": "^5.9.2"
  }
}
