# Keep this file server-side. Never put DIGISIGN_API_KEY in Expo/.env files.
DIGISIGN_API_KEY=replace-with-a-digisign-api-key
DIGISIGN_API_BASE_URL=https://sandbox.usedigisign.dev
# Optional: if omitted, the server selects the first workspace returned by DigiSign.
DIGISIGN_WORKSPACE_ID=
DEMO_RECIPIENT_NAME=DigiSign Demo Recipient
DEMO_RECIPIENT_EMAIL=demo@example.com
DEMO_SERVER_PORT=8787
